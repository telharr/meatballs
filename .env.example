# Copy to `.env` and fill in locally. Never commit `.env`.

# —— Panel auth (Sprint 3) ——
# Desktop / 127.0.0.1: skip login UI
AUTH_DISABLED=true
# Optional: show «local login» without full AUTH_DISABLED (127.0.0.1 only)
AUTH_LOCAL_BYPASS=false
ADMIN_USER=admin
# Generate: python -c "from panel.auth import hash_password; print(hash_password('your-password'))"
ADMIN_PASS_HASH=
JWT_SECRET=change-me-to-a-long-random-string
PANEL_HOST=127.0.0.1

# —— FTP (files channel) ——
FTP_HOST=your.server.example
FTP_PORT=21
FTP_USER=
FTP_PASS=
FTP_REMOTE_DIR=/ServerWorld
FTP_REMOTE_MODS_DIR=/ServerWorld/mods
FTP_USE_TLS=false
FTP_TIMEOUT=30

# —— RCON ——
RCON_HOST=your.server.example
RCON_PORT=16284
RCON_PASS=
RCON_TIMEOUT=10

# —— Public listing / launch invites ——
PUBLIC_HOST=your.server.example
PUBLIC_NAME=My PZ Server
GAME_PORT=16282
QUERY_PORT=16281
MAX_PLAYERS=32
SERVER_PASSWORD=
DISCORD_INVITE=
DISCORD_WEBHOOK=

# —— Steam Workshop (optional publish) ——
STEAM_USERNAME=
STEAM_PASSWORD=
STEAMCMD_PATH=
STEAM_PUBLISHED_FILE_ID=

# —— Local dedicated smoke (optional) ——
# Folder with StartServer64.bat OR Steam client ProjectZomboid (jre64 + GameServer).
PZ_DEDICATED_DIR=
PZ_SERVER_NAME=world
PZ_ADMIN_PASSWORD=localadmin
