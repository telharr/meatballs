{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MEATBALLS Mod Catalog",
  "type": "object",
  "required": ["name", "items"],
  "properties": {
    "name": { "type": "string" },
    "ini_filename": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "id"],
        "properties": {
          "kind": { "type": "string", "enum": ["mod", "library"] },
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "workshop_id": { "type": "string", "pattern": "^[0-9]+$" },
          "source": { "type": "string", "enum": ["local", "workshop"] },
          "path": { "type": "string" },
          "enabled": { "type": "boolean" },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
